type Query {
    getAllClients : [Client]
    getClientById(id:ID): Client
}

type Mutation {
    createClient(name:String!, code:Int!): Client
    updateClient(id:ID!,name:String,code:Int,isActive:Boolean):Client
    deleteClient(id:ID!):Boolean
}

type Client {
    id:ID
    name: String
    code : Int
    createdAt: String
    UpdatedAt: String
    isActive: Boolean
}